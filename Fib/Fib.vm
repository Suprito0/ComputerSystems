// Contains a function Fib.fib that calculates and returns the nth Fibonacci number recursively
// n is supplied as an argument

function Fib.fib 0
// if n < 2, return n
push argument 0
push constant 2
lt
if-goto BASECASE
goto START

label BASECASE
push argument 0
return

label START
// Save n temporarily
push argument 0
push constant 1
sub
call Fib.fib 1     // Fib.fib(n-1)
push argument 0
push constant 2
sub
call Fib.fib 1     // Fib.fib(n-2)
add
return
