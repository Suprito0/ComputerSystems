// Contains a function ArrMax.arrMax that finds and returns the largest element in the array a of length b.
// a & b are both supplied as arguments

function ArrMax.arrMax 0

push argument 1
push constant 0
eq
if-goto EMPTY
goto INIT

label EMPTY
push constant 0
return

label INIT
push argument 0        // push base address (m)
pop pointer 1          // THAT = m  (point to first element)

push that 0            // max = arr[0]
pop local 0            // use local 0 to store current max

push constant 1
pop local 1            // index = 1

label LOOP
// if index >= n, exit
push local 1
push argument 1
ge
if-goto DONE

// THAT = m + index
push argument 0
push local 1
add
pop pointer 1

// if arr[index] > max, update max
push that 0
push local 0
gt
if-goto UPDATE
goto NEXT

label UPDATE
push that 0
pop local 0

label NEXT
// index++
push local 1
push constant 1
add
pop local 1

goto LOOP

label DONE
push local 0
return
