// Calculates a = x * y
// a is a local variable
// x and y are static variables

// initialize a = 0
push constant 0
pop local 0     // a = 0

// copy y to local 1 (counter)
push static 1
pop local 1

// check if y < 0
push local 1
push constant 0
lt
if-goto NEG_Y

// if y >= 0, go to LOOP
goto MULT_LOOP

// handle negative y: make y positive and invert x
label NEG_Y
push static 0
neg
pop static 0          // x = -x
push local 1
neg
pop local 1           // y = -y

// main loop
label MULT_LOOP
push local 1
push constant 0
eq
if-goto END           // if counter == 0 -> end

// a = a + x
push local 0
push static 0
add
pop local 0

// counter = counter - 1
push local 1
push constant 1
sub
pop local 1

goto MULT_LOOP

label END
goto END