// Mult.vm
// Multiply a = x * y
// a is local 0, x is static 0, y is static 1

// Step 0: Initialize local variables
push constant 0
pop local 0     // a = 0
push constant 0
pop local 1     // temp counter / abs(y)
push constant 0
pop local 2     // flag for result sign

// Step 1: Load x and y
push static 0
pop local 3     // local 3 = x
push static 1
pop local 4     // local 4 = y

// Step 2: Determine sign of result
push local 3
push constant 0
lt
if-goto X_NEG
goto X_POS
label X_NEG
push constant 1
pop local 2     // flip sign flag if x is negative
neg
pop local 3     // x = abs(x)
label X_POS

push local 4
push constant 0
lt
if-goto Y_NEG
goto Y_POS
label Y_NEG
push constant 1
push local 2
add
pop local 2     // flip sign flag if y is negative
neg
pop local 4     // y = abs(y)
label Y_POS

// Step 3: Set counter = y
push local 4
pop local 1     // counter = abs(y)

// Step 4: Loop: a = a + x, counter times
label MULT_LOOP
push local 1
push constant 0
eq
if-goto END_MULT

push local 0
push local 3
add
pop local 0     // a += x

push local 1
push constant 1
sub
pop local 1     // counter--

goto MULT_LOOP

label END_MULT
// Step 5: Apply sign
push local 2
push constant 1
eq
if-goto NEG_RESULT
goto END

label NEG_RESULT
push local 0
neg
pop local 0

label END
goto END
